# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# Versions
N8N_VERSION=2.47.7
EVOLUTION_VERSION=v2.3.7
CLOUDFLARED_VERSION=2026.11.0

# General
DOMAIN=
TIMEZONE=America/Sao_Paulo

# Postgres (admin user + one password per app database)
POSTGRES_USER=
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
EVOLUTION_DB_PASSWORD=

# n8n
N8N_ENCRYPTION_KEY=
RUNNERS_AUTH_TOKEN=
# Set to false only while testing over plain http on the LAN
N8N_SECURE_COOKIE=true

# Evolution API
EVOLUTION_API_KEY=

# Cloudflare Tunnel (set COMPOSE_PROFILES=tunnel once the token is filled in)
CLOUDFLARE_TUNNEL_TOKEN=
COMPOSE_PROFILES=
