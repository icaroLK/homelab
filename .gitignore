# Backups: workflow exports, decrypted credentials, DB dumps. Never commit.
backups/

# Real secrets. Only the *.example templates are tracked.
.env
.env.*
!.env.example
!.env.*.example

# Anything that looks like a secret or data dump
*DECRYPTED*
*encryption-key*
*.dump
*.sql
*.sqlite
*.pem
*.key

# Container data volumes
data/
